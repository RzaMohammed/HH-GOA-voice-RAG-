# ──────────────────────────────────────────────
# Voice-Enabled RAG System — Environment Config
# Powered exclusively by Sarvam AI & ElevenLabs
# ──────────────────────────────────────────────
# Fill in your API keys below.
# Any key left blank will gracefully fall back to
# the built-in mock/offline provider.

# ── Sarvam AI (LLM, STT, TTS) ────────────────
SARVAM_API_KEY=
SARVAM_LLM_MODEL=sarvam-105b

# ── ElevenLabs (Voice STT / TTS) ─────────────
ELEVENLABS_API_KEY=

# ── Model Choices ────────────────────────────
EMBEDDING_MODEL=finetuned_multilingual_embedder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=sarvam

# ── Retrieval Tuning ────────────────────────
DENSE_TOP_K=50
BM25_TOP_K=50
HYBRID_ALPHA=0.6
RERANK_TOP_K=5
MIN_RETRIEVAL_SCORE=0.25

# ── Chunking Defaults ───────────────────────
DEFAULT_CHUNK_STRATEGY=adaptive
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=25

# ── Server ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
