# ──────────────────────────────────────────────
# Voice-Enabled RAG System — Environment Config
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Any key left blank will gracefully fall back to
# the built-in mock/offline provider.

# ── LLM Providers ───────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Voice / STT ─────────────────────────────
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Model Choices ────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# ── Retrieval Tuning ────────────────────────
DENSE_TOP_K=50
BM25_TOP_K=50
HYBRID_ALPHA=0.6
RERANK_TOP_K=5
MIN_RETRIEVAL_SCORE=0.25

# ── Chunking Defaults ───────────────────────
DEFAULT_CHUNK_STRATEGY=adaptive
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=25

# ── Server ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
